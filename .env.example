# MY PT STUDIO AI — configuration
#
# Copy to .env and fill in. Every value is validated at boot (src/config.js);
# the process refuses to start rather than failing per-request later.
#
# ─── DO NOT ADD THESE ────────────────────────────────────────────────────────
# JWT_SECRET, DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REFUSED at boot.
# Their absence is what makes user impersonation and direct database access
# impossible in this service rather than merely disallowed. If you find
# yourself wanting to add one, the change you actually want belongs in the ERP.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# ─── AI provider ─────────────────────────────────────────────────────────────
# OpenRouter, matching the ERP backend so there is one account and one bill.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_PRIMARY_MODEL=openai/gpt-oss-120b:free
AI_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_REQUEST_TIMEOUT_MS=60000

# ─── ERP backend — the authority ─────────────────────────────────────────────
# Every fact the agent states is read back through this service.
ERP_BACKEND_URL=http://localhost:5000
ERP_REQUEST_TIMEOUT_MS=10000

# Proves the caller is THIS SERVICE. It does not identify a user — the
# forwarded end-user JWT does that. Minimum 32 characters.
# Generate with:  openssl rand -base64 48
SERVICE_AUTH_SECRET=

# ─── Studio time ─────────────────────────────────────────────────────────────
# The calendar "this month" and "expiring soon" are answered against. Without
# it the model dates relative questions from its own training cutoff and states
# the result as though it came from the studio's records. Validated at boot
# against the real IANA database, so a typo refuses to start.
STUDIO_TIMEZONE=Asia/Kolkata

# ─── Budgets ─────────────────────────────────────────────────────────────────
# A cap on what may ENTER a prompt. The model's max_tokens caps only the reply;
# without these a client with four years of attendance sets the request size.
# Over-budget results are truncated and the model is told they were truncated —
# a partial list it believes is complete becomes a confidently wrong total.
MAX_TOOL_RESULT_CHARS=6000
MAX_CONTEXT_CHARS=24000

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. "*" is refused; an empty list is refused in
# production. This API is authenticated, so a reflected origin would be a
# credential-forwarding hole.
ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
# Per token. One studio behind one NAT is not throttled as a single user.
RATE_LIMIT_MAX=30
# Per IP, as a backstop. The token limiter runs before authentication, so a
# caller rotating junk tokens would otherwise get a fresh bucket every request.
# Keep this well above RATE_LIMIT_MAX — it exists for floods, not normal use.
RATE_LIMIT_IP_MAX=120
