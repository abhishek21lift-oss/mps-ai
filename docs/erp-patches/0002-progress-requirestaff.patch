diff --git a/src/__tests__/progress.requireStaff.test.js b/src/__tests__/progress.requireStaff.test.js
new file mode 100644
index 0000000..81690c5
--- /dev/null
+++ b/src/__tests__/progress.requireStaff.test.js
@@ -0,0 +1,63 @@
+// /api/progress is staff-only, for the same reason /api/pt-os is.
+//
+// The shape of the gap this closes: every GET on that router takes an OPTIONAL
+// client_id, so omitting it returns the whole organisation's rows. tenantScope()
+// keeps that inside one studio — the boundary that matters for tenancy — but a
+// `member` account created by a client login carries that studio's
+// organization_id. So `auth` alone let a client read every other client's body
+// composition, health notes and trainer notes in their own gym.
+//
+// This asserts the mount, not the handlers, because the mount is where the fix
+// lives and where a future refactor would silently drop it.
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+
+const server = fs.readFileSync(path.join(__dirname, '..', 'server.js'), 'utf8');
+
+describe('the /api/progress mount', () => {
+  test('is gated with auth and requireStaff', () => {
+    expect(server).toMatch(
+      /app\.use\('\/api\/progress',\s*auth,\s*requireStaff,\s*require\('\.\/modules\/progress\/progress\.routes'\)\)/
+    );
+  });
+
+  test('is not mounted ungated anywhere', () => {
+    // The failing shape, written out so a reviewer can see exactly what
+    // regressed if this ever goes red.
+    const ungated = /app\.use\('\/api\/progress',\s*require\(/;
+    expect(server).not.toMatch(ungated);
+  });
+
+  test('requireStaff is imported where the mount can see it', () => {
+    expect(server).toMatch(/const \{[^}]*requireStaff[^}]*\} = require\('\.\/middleware\/rbac'\)/);
+  });
+});
+
+describe('requireStaff itself still excludes client accounts', () => {
+  const { requireStaff, STAFF_ROLES } = require('../middleware/rbac');
+
+  const run = (user) => {
+    const req = { user };
+    let status = null;
+    const res = { status: (s) => { status = s; return res; }, json: () => res };
+    let passed = false;
+    requireStaff(req, res, () => { passed = true; });
+    return { passed, status };
+  };
+
+  test('a member is refused', () => {
+    expect(run({ role: 'member', organization_id: 'org-1' })).toMatchObject({ passed: false, status: 403 });
+  });
+
+  test.each(STAFF_ROLES)('%s is admitted', (role) => {
+    expect(run({ role, organization_id: 'org-1' }).passed).toBe(true);
+  });
+
+  test('member is not in the staff allow-list', () => {
+    // Belt and braces: the list is an allow-list precisely so a role added
+    // later and forgotten gets a visible 403 rather than the whole studio.
+    expect(STAFF_ROLES).not.toContain('member');
+  });
+});
