@@ -655,7 +655,20 @@ app.use('/api/client-login',     auth, requireStaff, require('./routes/client-lo
 // ────────────────────────
 // BUSINESS FLOW ROUTES (v4 — Progress, Automation)
 // ────────────────────────
-app.use('/api/progress',         require('./modules/progress/progress.routes'));
+// Staff only, for exactly the reason /api/pt-os is — and this router was missed
+// when that gate went in.
+//
+// Every GET here takes an OPTIONAL client_id: omit it and you get the whole
+// organisation's rows. Nine routes behave that way (assessments, goals,
+// weekly-checkins, strength-logs, progress-photos, lifestyle, nutrition,
+// mobility, posture). tenantScope() keeps that inside one studio, which is the
+// boundary that matters for tenancy — but a `member` account created by a
+// client login carries that studio's organization_id, so `auth` alone let a
+// client read every other client's body composition, health notes and trainer
+// notes in their gym.
+//
+// A client's own progress is served by /api/me, which scopes to the caller.
+app.use('/api/progress',         auth, requireStaff, require('./modules/progress/progress.routes'));
 app.use('/api/automation',       require('./modules/automation/automation.routes'));
 
